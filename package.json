{
  "name": "nearbygig",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "scripts": {
    "install-all": "npm install --workspaces",
    "dev": "concurrently \"npm run dev --workspace client\" \"npm run dev --workspace server\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}